---
interface Props {
  name: string;
  role: string;
  description: string;
  imageUrl?: string;
  linkedinUrl?: string;
}

const {
  name,
  role,
  description,
  imageUrl,
  linkedinUrl = "#",
} = Astro.props;

const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase();
---

<article class="flex flex-col rounded-xl bg-cream shadow-[0_4px_12px_rgba(197,190,182,0.25)] overflow-hidden">
  <div class="p-8 lg:p-9">
    <!-- Person header -->
    <div class="flex items-end justify-between mb-6 gap-3">
      <div class="flex items-end gap-3 sm:gap-5 min-w-0">
        <!-- Avatar -->
        {imageUrl ? (
          <div class="w-16 h-16 sm:w-24 sm:h-24 rounded-full overflow-hidden bg-sage shrink-0">
            <img src={imageUrl} alt={name} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ) : (
          <div class="flex items-center justify-center w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-sage text-h2 sm:text-h1 font-medium text-dark shrink-0">
            {initials}
          </div>
        )}
        <div class="flex flex-col gap-0.5">
          <h3 class="text-h3 font-medium text-dark">{name}</h3>
          <span class="text-small text-muted">{role}</span>
        </div>
      </div>

      <!-- LinkedIn -->
      <a
        href={linkedinUrl}
        class="flex items-center justify-center w-8 h-8 rounded-full bg-dark text-sage hover:opacity-80 transition-opacity"
        aria-label={`${name} on LinkedIn`}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>

    <!-- Divider -->
    <hr class="mb-6 border-dark/20" />

    <!-- Bio -->
    <p class="text-body leading-relaxed text-body">{description}</p>
  </div>
</article>
