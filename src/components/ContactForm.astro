---

<section id="contact" class="px-4 sm:px-6 lg:px-[100px]">
  <div class="relative rounded-xl bg-cream px-5 py-10 sm:px-8 sm:py-14 lg:px-[100px] lg:py-16 overflow-hidden">
    <form class="flex flex-col gap-10 max-w-[556px]">
      <!-- Radio group -->
      <div class="flex flex-wrap gap-8">
        <label class="flex items-center gap-3 cursor-pointer">
          <span class="relative flex items-center justify-center w-7 h-7 rounded-full border border-dark">
            <input type="radio" name="patient_type" value="new" checked class="peer sr-only" />
            <span class="w-4 h-4 rounded-full bg-sage scale-0 peer-checked:scale-100 transition-transform"></span>
          </span>
          <span class="text-body text-dark">New Patient</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <span class="relative flex items-center justify-center w-7 h-7 rounded-full border border-dark">
            <input type="radio" name="patient_type" value="existing" class="peer sr-only" />
            <span class="w-4 h-4 rounded-full bg-sage scale-0 peer-checked:scale-100 transition-transform"></span>
          </span>
          <span class="text-body text-dark">Existing Patient</span>
        </label>
      </div>

      <!-- Fields -->
      <div class="flex flex-col gap-6">
        <!-- Full Name -->
        <div class="flex flex-col gap-1.5">
          <label for="fullname" class="text-small text-dark">Full Name</label>
          <input
            type="text"
            id="fullname"
            name="fullname"
            placeholder="Your full name"
            class="rounded-md border border-border bg-white px-7 py-4 text-[15px] text-dark placeholder:text-muted outline-none focus:border-dark transition-colors"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-small text-dark">Email*</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="your@email.com"
            required
            class="rounded-md border border-border bg-white px-7 py-4 text-[15px] text-dark placeholder:text-muted outline-none focus:border-dark transition-colors"
          />
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-small text-dark">How can we help?*</label>
          <textarea
            id="message"
            name="message"
            placeholder="Tell us about your dental needs..."
            rows="6"
            required
            class="rounded-md border border-border bg-white px-7 py-4 text-[15px] text-dark placeholder:text-muted outline-none focus:border-dark transition-colors resize-none"
          ></textarea>
        </div>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        class="w-full rounded-xl bg-dark py-4 text-body font-bold text-white hover:bg-dark-lighter transition-colors cursor-pointer"
      >
        Book Appointment
      </button>
    </form>

    <!-- Decorative illustration -->
    <div class="absolute right-12 bottom-12 hidden lg:block" aria-hidden="true">
      <svg width="180" height="180" viewBox="0 0 180 180" fill="none">
        <path d="M90 0 C90 50, 130 90, 180 90 C130 90, 90 130, 90 180 C90 130, 50 90, 0 90 C50 90, 90 50, 90 0Z" fill="#C3DED8" opacity="0.6"/>
        <path d="M140 30 C140 75, 165 100, 180 100 C165 100, 140 125, 140 150 C140 125, 115 100, 100 100 C115 100, 140 75, 140 30Z" fill="#1A1A1A" opacity="0.8"/>
      </svg>
    </div>
  </div>
</section>
