---
interface Props {
  tag: string;
  tagColor?: "sage" | "olive" | "slate";
  description: string;
  descriptionWidth?: string;
}

const {
  tag,
  tagColor = "sage",
  description,
  descriptionWidth = "max-w-[580px]",
} = Astro.props;

const colorMap = {
  sage: "bg-sage",
  olive: "bg-olive",
  slate: "bg-slate",
};
---

<div class="flex flex-col gap-6 px-4 sm:px-6 lg:px-[100px]">
  <div class="inline-flex">
    <span class={`inline-block rounded-md px-3 py-1 text-h2 sm:text-h1 font-medium text-dark ${colorMap[tagColor]}`}>
      {tag}
    </span>
  </div>
  <p class={`text-body leading-relaxed text-body ${descriptionWidth}`}>
    {description}
  </p>
</div>
