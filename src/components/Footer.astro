---
const navLinks = [
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Treatments", href: "#treatments" },
  { label: "Doctors", href: "#doctors" },
  { label: "Blog", href: "#blog" },
];

const contactInfo = [
  { label: "Email", value: "hello@brightsmile.com" },
  { label: "Phone", value: "(555) 234-5678" },
  { label: "Address", value: "123 Smile Ave, Suite 100, New York, NY 10001" },
];
---

<footer class="px-4 sm:px-6 lg:px-[100px]">
  <div class="rounded-t-xl bg-dark px-5 py-10 sm:px-8 sm:py-12 lg:px-14 lg:py-14">
    <!-- Top row: logo, nav, socials -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 mb-14">
      <!-- Logo -->
      <span class="text-h3 font-medium text-cream">BrightSmile</span>

      <!-- Nav -->
      <nav class="flex flex-wrap gap-8 lg:gap-10">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[15px] text-cream hover:text-sage transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Social icons -->
      <div class="flex items-center gap-5">
        <!-- LinkedIn -->
        <a href="#" class="text-cream hover:text-sage transition-colors" aria-label="LinkedIn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <!-- X / Twitter -->
        <a href="#" class="text-cream hover:text-sage transition-colors" aria-label="Twitter">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <!-- Instagram -->
        <a href="#" class="text-cream hover:text-sage transition-colors" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Contact + Newsletter row -->
    <div class="flex flex-col lg:flex-row justify-between gap-10 mb-14">
      <!-- Contact info -->
      <div class="flex flex-col gap-6">
        <span class="text-h3 font-medium text-cream">Contact Us</span>
        <div class="flex flex-col gap-5">
          {contactInfo.map((item) => (
            <div class="flex flex-col gap-1">
              <span class="text-small text-cream/60">{item.label}</span>
              <span class="text-[15px] text-cream">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Newsletter -->
      <div class="flex flex-col items-start gap-4 rounded-xl bg-dark-lighter p-6 sm:p-10 lg:p-14">
        <form class="flex flex-col sm:flex-row gap-5">
          <input
            type="email"
            placeholder="Your email"
            class="rounded-xl border border-cream/30 bg-transparent px-6 py-4 sm:px-8 sm:py-5 text-[15px] text-cream placeholder:text-cream/50 outline-none focus:border-cream transition-colors w-full sm:w-[285px]"
          />
          <button
            type="submit"
            class="rounded-xl bg-sage px-8 py-5 text-[15px] font-bold text-dark hover:opacity-90 transition-opacity cursor-pointer"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom divider + copyright -->
    <hr class="border-white/20 mb-10" />
    <div class="flex flex-col sm:flex-row justify-between gap-4">
      <span class="text-[15px] text-cream">&copy; 2026 BrightSmile Dental. All Rights Reserved.</span>
      <a href="#" class="text-[15px] text-cream hover:underline">Privacy Policy</a>
    </div>
  </div>
</footer>
