---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABanner from "../components/CTABanner.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ProcessStep from "../components/ProcessStep.astro";
import TeamCard from "../components/TeamCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

/* ─── SVG icons for service cards (lucide) ─── */
const stethoscopeIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/></svg>`;
const sparklesIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>`;
const shieldIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`;
const smileIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>`;
const heartPulseIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/></svg>`;
const syringeIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 2 4 4"/><path d="m17 7 3-3"/><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"/><path d="m9 11 4 4"/><path d="m5 19-3 3"/><path d="m14 4 6 6"/></svg>`;

const processSteps = [
  {
    number: "01",
    title: "Initial Consultation",
    description: "We begin with a thorough oral examination, digital X-rays, and a detailed discussion about your dental history, concerns, and smile goals.",
    bgColor: "sage" as const,
  },
  {
    number: "02",
    title: "Personalized Treatment Plan",
    description: "Based on our findings, we create a comprehensive treatment plan tailored to your specific needs, timeline, and budget preferences.",
    bgColor: "cream" as const,
  },
  {
    number: "03",
    title: "Treatment Preparation",
    description: "We prepare you for your procedure with detailed explanations, sedation options, and pre-treatment care instructions to ensure your comfort.",
    bgColor: "cream" as const,
  },
  {
    number: "04",
    title: "Expert Treatment",
    description: "Our experienced dental professionals perform your treatment using state-of-the-art technology and the gentlest techniques available.",
    bgColor: "cream" as const,
  },
  {
    number: "05",
    title: "Recovery & Aftercare",
    description: "We provide thorough post-treatment instructions, pain management guidance, and schedule follow-up visits to monitor your healing progress.",
    bgColor: "cream" as const,
  },
  {
    number: "06",
    title: "Ongoing Maintenance",
    description: "Regular checkups and cleanings keep your smile healthy for life. We create a personalized maintenance schedule based on your dental needs.",
    bgColor: "cream" as const,
  },
];
---

<Layout>
  <div class="mx-auto max-w-[1440px] bg-cream rounded-lg overflow-hidden flex flex-col p-1.5 gap-0">
    <!-- ─── Navbar ─── -->
    <Navbar />

    <!-- ─── Hero ─── -->
    <Hero />
  </div>

  <div class="mx-auto max-w-[1440px] flex flex-col gap-20 py-20">
    <!-- ═══════════════════════════════════════════ -->
    <!-- SERVICES SECTION                           -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="services">
      <SectionHeading
        tag="Our Services"
        tagColor="sage"
        description="We provide comprehensive dental care for the entire family. From preventive checkups to advanced cosmetic treatments, every visit is tailored to your needs."
      />

      <div class="mt-10 flex flex-col gap-6 sm:gap-10 px-4 sm:px-6 lg:px-[100px]">
        <!-- Row 1 -->
        <div class="grid md:grid-cols-2 gap-10">
          <ServiceCard
            title={["General", "Dentistry"]}
            iconName={stethoscopeIcon}
            bgColor="cream"
          />
          <ServiceCard
            title={["Cosmetic", "Dentistry"]}
            iconName={sparklesIcon}
            bgColor="sage"
          />
        </div>
        <!-- Row 2 -->
        <div class="grid md:grid-cols-2 gap-10">
          <ServiceCard
            title={["Preventive", "Care"]}
            iconName={shieldIcon}
            bgColor="dark"
          />
          <ServiceCard
            title={["Pediatric", "Dentistry"]}
            iconName={smileIcon}
            bgColor="cream"
          />
        </div>
        <!-- Row 3 -->
        <div class="grid md:grid-cols-2 gap-10">
          <ServiceCard
            title={["Orthodontic", "Treatment"]}
            iconName={heartPulseIcon}
            bgColor="olive"
          />
          <ServiceCard
            title={["Oral Surgery", "& Implants"]}
            iconName={syringeIcon}
            bgColor="dark"
          />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CTA BANNER                                 -->
    <!-- ═══════════════════════════════════════════ -->
    <CTABanner />

    <!-- ═══════════════════════════════════════════ -->
    <!-- CASE STUDIES / PATIENT STORIES             -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="treatments">
      <SectionHeading
        tag="Patient Stories"
        tagColor="slate"
        description="Real results from real patients — see how our dental treatments have transformed smiles and improved lives."
      />

      <div class="mt-10 grid sm:grid-cols-2 md:grid-cols-3 gap-1.5 px-4 sm:px-6 lg:px-[100px]">
        <CaseStudyCard
          image="/images/generated-1772044833658.png"
          imageAlt="Before and after orthodontic treatment"
          stat="95%"
          statLabel="improvement in bite function"
          description="A patient with severe misalignment received Invisalign treatment over 14 months, resulting in a perfectly aligned smile."
          bgColor="sage"
        />
        <CaseStudyCard
          image="/images/generated-1772044847628.png"
          imageAlt="Smile makeover result"
          stat="100%"
          statLabel="patient satisfaction"
          description="Complete smile makeover using porcelain veneers and professional whitening, dramatically enhancing confidence."
          bgColor="cream"
        />
        <CaseStudyCard
          image="/images/generated-1772044860717.png"
          imageAlt="Dental implant success"
          stat="98%"
          statLabel="implant success rate"
          description="Full-arch dental implant restoration gave this patient a complete, natural-looking smile after years of tooth loss."
          bgColor="slate"
        />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- YOUR DENTAL JOURNEY (Process)              -->
    <!-- ═══════════════════════════════════════════ -->
    <section>
      <SectionHeading
        tag="Your Dental Journey"
        tagColor="olive"
        description="A step-by-step guide to your treatment experience"
        descriptionWidth="max-w-[360px]"
      />

      <div class="mt-10 flex flex-col gap-6 sm:gap-8 px-4 sm:px-6 lg:px-[100px]">
        {processSteps.map((step, i) => (
          <ProcessStep
            number={step.number}
            title={step.title}
            description={step.description}
            isOpen={i === 0}
            bgColor={step.bgColor}
          />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- OUR DENTISTS (Team)                        -->
    <!-- ═══════════════════════════════════════════ -->
    <section id="doctors">
      <SectionHeading
        tag="Our Dentists"
        tagColor="sage"
        description="Meet the experienced dental professionals dedicated to delivering gentle, high-quality care for every patient."
        descriptionWidth="max-w-[473px]"
      />

      <div class="mt-10 grid sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-10 px-4 sm:px-6 lg:px-[100px]">
        <TeamCard
          name="Dr. Emily Chen"
          role="Lead Orthodontist"
          description="10+ years in orthodontics and Invisalign. Board-certified specialist with over 2,000 cases completed."
        />
        <TeamCard
          name="Dr. James Rodriguez"
          role="Cosmetic Dentist"
          description="Specializing in veneers, whitening, and complete smile makeovers. Passionate about creating confident smiles."
        />
        <TeamCard
          name="Dr. Sarah Kim"
          role="Pediatric Dentist"
          description="Making dental visits fun for kids of all ages. Certified pediatric specialist with a gentle, caring approach."
        />
      </div>

      <div class="mt-10 flex justify-end px-4 sm:px-6 lg:px-[100px]">
        <a
          href="#doctors"
          class="inline-flex items-center justify-center rounded-xl bg-dark px-8 py-5 text-body font-bold text-white hover:bg-dark-lighter transition-colors"
        >
          Meet the team
        </a>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TESTIMONIALS                               -->
    <!-- ═══════════════════════════════════════════ -->
    <section>
      <SectionHeading
        tag="Testimonials"
        tagColor="olive"
        description="Hear from patients who trust us with their smiles — genuine reviews from our dental family."
        descriptionWidth="max-w-[473px]"
      />

      <div class="mt-10 grid sm:grid-cols-2 md:grid-cols-3 gap-1.5 px-4 sm:px-6 lg:px-[100px]">
        <TestimonialCard
          quote="I used to dread going to the dentist, but BrightSmile completely changed that for me. Dr. Chen and the team are so gentle and caring. My Invisalign treatment was seamless and now I can't stop smiling."
          name="Sarah Mitchell"
          role="Patient since 2022"
          bgColor="cream"
        />
        <TestimonialCard
          quote="After years of putting off dental work, I finally went to BrightSmile for implants. The procedure was virtually painless and the results are incredible — my new teeth look and feel completely natural. I wish I had done this sooner."
          name="David Park"
          role="Patient since 2021"
          bgColor="sage"
        />
        <TestimonialCard
          quote="My kids actually look forward to their dental appointments now! The pediatric team at BrightSmile is amazing with children. They make every visit fun and educational. As a parent, I couldn't ask for a better dental home for my family."
          name="Lisa Thompson"
          role="Patient since 2023"
          bgColor="olive"
        />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CONTACT FORM                               -->
    <!-- ═══════════════════════════════════════════ -->
    <section>
      <SectionHeading
        tag="Book a Visit"
        tagColor="slate"
        description="Schedule your appointment or ask us any questions about our dental services."
        descriptionWidth="max-w-[380px]"
      />

      <div class="mt-10">
        <ContactForm />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════ -->
    <!-- FOOTER                                     -->
    <!-- ═══════════════════════════════════════════ -->
    <Footer />
  </div>
</Layout>
